# exu · .htaccess · version 0.4.1
# Page de garde statique sur hébergement mutualisé OVH (Apache 2.4), derrière le CDN Basic.
# Après chaque mise à jour, purger le cache du CDN depuis l'espace client OVH.

# ------------------------------------------------------------------
# Généralités
# ------------------------------------------------------------------
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddType text/plain .txt
AddCharset utf-8 .html .css .txt .xml .webmanifest

# ------------------------------------------------------------------
# Redirections : HTTPS obligatoire, domaine sans « www »
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP vers HTTPS (le second test évite une boucle si le CDN joint le serveur en HTTP)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://exu.fr%{REQUEST_URI} [R=301,L]

  # www.exu.fr vers exu.fr
  RewriteCond %{HTTP_HOST} ^www\.exu\.fr$ [NC]
  RewriteRule ^ https://exu.fr%{REQUEST_URI} [R=301,L]

  # /index.html vers / (une seule adresse pour l'accueil)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://exu.fr/ [R=301,L]

  # Fichiers et dossiers cachés introuvables, sauf /.well-known/
  RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
</IfModule>

# Fichiers de travail, sauvegardes et archives : jamais servis
<FilesMatch "(\.(bak|old|orig|save|swp|tmp|log|sql|ini|conf|sh|md|zip|tar|gz|7z)|~)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# En-têtes de sécurité
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  # HTTPS imposé au navigateur pendant un an (sans includeSubDomains ni preload pour l'instant)
  Header always set Strict-Transport-Security "max-age=31536000"

  # Rien d'autre que les ressources du site lui-même ; aucun script, aucun formulaire, aucun cadre
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # La page d'erreur ne doit pas être indexée
  <Files "404.html">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

# ------------------------------------------------------------------
# Cache (navigateur et CDN)
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 hour"
  ExpiresByType text/html                     "access plus 10 minutes"
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 month"
  ExpiresByType image/x-icon                  "access plus 1 month"
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType application/xml               "access plus 1 day"
</IfModule>

# ------------------------------------------------------------------
# Compression
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml application/manifest+json image/svg+xml image/x-icon
</IfModule>
